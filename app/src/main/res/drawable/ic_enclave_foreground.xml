<?xml version="1.0" encoding="utf-8"?>
<!--
    Enclave app mark: an isometric cube whose three faces carry an endless-maze motif.
    Converted from design_handoff_enclave_assistant/enclave_icon.svg.

    The source art fills a 100x100 box, but an adaptive icon only guarantees the middle
    ~66% is visible (the rest can be masked away by the launcher). The group below scales
    the art to 0.62 about the centre so the whole cube stays inside the safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <group
        android:pivotX="50"
        android:pivotY="50"
        android:scaleX="0.62"
        android:scaleY="0.62">

        <!-- cube faces: top, right, left -->
        <path
            android:fillColor="#B768FF"
            android:pathData="M50,10 L86,31 L50,52 L14,31 Z" />
        <path
            android:fillColor="#7C3BE0"
            android:pathData="M86,31 L86,73 L50,94 L50,52 Z" />
        <path
            android:fillColor="#571FB0"
            android:pathData="M14,31 L50,52 L50,94 L14,73 Z" />

        <!-- maze rings on the top face -->
        <path
            android:pathData="M50,17.35 L73.4,31 L50,44.65 L26.6,31 Z"
            android:strokeColor="#FFFFFF"
            android:strokeAlpha="0.5"
            android:strokeWidth="2"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M50,23.02 L63.68,31 L50,39.02 L36.32,31 Z"
            android:strokeColor="#FFFFFF"
            android:strokeAlpha="0.3"
            android:strokeWidth="2"
            android:strokeLineJoin="round" />

        <!-- maze rings on the right face -->
        <path
            android:pathData="M79.7,42 L79.7,69.3 L56.3,82.98 L56.3,55.68 Z"
            android:strokeColor="#FFFFFF"
            android:strokeAlpha="0.28"
            android:strokeWidth="2"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M74.84,50.53 L74.84,66.49 L61.16,74.47 L61.16,58.51 Z"
            android:strokeColor="#FFFFFF"
            android:strokeAlpha="0.16"
            android:strokeWidth="2"
            android:strokeLineJoin="round" />

        <!-- maze rings on the left face -->
        <path
            android:pathData="M20.3,42 L43.7,55.68 L43.7,82.98 L20.3,69.3 Z"
            android:strokeColor="#FFFFFF"
            android:strokeAlpha="0.4"
            android:strokeWidth="2"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M25.16,50.53 L38.84,58.51 L38.84,74.47 L25.16,66.49 Z"
            android:strokeColor="#FFFFFF"
            android:strokeAlpha="0.22"
            android:strokeWidth="2"
            android:strokeLineJoin="round" />
    </group>
</vector>
